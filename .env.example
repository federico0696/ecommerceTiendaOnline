# =====================================================================
#  VIVERO API - VARIABLES DE ENTORNO
#  Todos los valores de este archivo son FICTICIOS. Sirven para levantar
#  el proyecto en local y para documentar qué necesita cada integración.
#  Cuando existan servidores y cuentas reales, este archivo sale de git.
# =====================================================================

# ---------- Aplicación ----------
NODE_ENV=development
APP_NOMBRE=Vivero API
APP_PUERTO=3000
APP_URL=http://localhost:3000
APP_PREFIJO_API=api/v1
APP_CORS_ORIGENES=http://localhost:5173,http://localhost:8081
APP_LOG_NIVEL=debug

# ---------- Base de datos (PostgreSQL) ----------
DB_HOST=localhost
DB_PUERTO=5432
DB_USUARIO=vivero
DB_PASSWORD=vivero_dev_password
DB_NOMBRE=vivero_db
DB_SSL=false
# En desarrollo sincroniza el esquema automáticamente. En producción SIEMPRE false (se usan migraciones).
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ---------- Redis (sesiones del bot, colas y sockets) ----------
REDIS_HOST=localhost
REDIS_PUERTO=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIJO=vivero

# ---------- Autenticación ----------
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRACION=8h
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-largo-y-aleatorio
JWT_REFRESH_EXPIRACION=30d
BCRYPT_ROUNDS=10
# Usuario root que crea el seed inicial
ROOT_EMAIL=root@vivero.local
ROOT_PASSWORD=Root1234!
ROOT_NOMBRE=Federico

# ---------- Inteligencia artificial ----------
# Proveedor por defecto: mock | openai | anthropic
# "mock" responde sin llamar a ningún servicio externo (ideal para demos y tests).
IA_PROVEEDOR=mock
IA_MAX_TOKENS=1024
IA_MAX_ITERACIONES_HERRAMIENTAS=5
IA_HISTORIAL_MAX_MENSAJES=40
OPENAI_API_KEY=sk-ficticia-reemplazar
OPENAI_MODELO=gpt-4.1
OPENAI_MODELO_VISION=gpt-4.1
ANTHROPIC_API_KEY=sk-ant-ficticia-reemplazar
ANTHROPIC_MODELO=claude-opus-5-5

# ---------- Firebase (push a la app) ----------
FIREBASE_PROJECT_ID=vivero-app-ficticio
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@vivero-app-ficticio.iam.gserviceaccount.com
# Clave privada en una sola línea con \n literales. Ficticia.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nFICTICIA\n-----END PRIVATE KEY-----\n"
FIREBASE_HABILITADO=false

# ---------- WhatsApp (Meta Cloud API) ----------
WHATSAPP_HABILITADO=false
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_TOKEN=token-ficticio
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_VERIFY_TOKEN=verificacion-webhook-ficticia
WHATSAPP_APP_SECRET=secreto-app-ficticio

# ---------- Correo ----------
MAIL_HABILITADO=false
MAIL_HOST=smtp.ficticio.local
MAIL_PUERTO=587
MAIL_USUARIO=no-reply@vivero.local
MAIL_PASSWORD=ficticia
MAIL_FROM="Vivero <no-reply@vivero.local>"

# ---------- Archivos (S3 o disco local) ----------
# Proveedor: local | s3
ARCHIVOS_PROVEEDOR=local
ARCHIVOS_LOCAL_RUTA=./uploads
ARCHIVOS_URL_PUBLICA=http://localhost:3000/uploads
S3_REGION=us-east-1
S3_BUCKET=vivero-archivos-ficticio
S3_ACCESS_KEY_ID=AKIAFICTICIA
S3_SECRET_ACCESS_KEY=secretoficticio
S3_ENDPOINT=

# ---------- Límites ----------
THROTTLE_TTL_SEGUNDOS=60
THROTTLE_LIMITE=120
