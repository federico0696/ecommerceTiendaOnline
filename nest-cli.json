{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [{ "include": "**/*.txt", "outDir": "dist" }, { "include": "**/*.json", "outDir": "dist", "exclude": "**/tsconfig*.json" }],
    "watchAssets": true
  }
}
